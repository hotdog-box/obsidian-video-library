{
  "name": "obsidian-video-library",
  "version": "0.1.3",
  "private": true,
  "description": "An Obsidian plugin to collect, organize and watch video links with covers and custom categories.",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "tsc --noEmit && node build.mjs",
    "test": "tsc -p tsconfig.test.json && node tests/.tmp/tests/providers.test.js"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "video",
    "bilibili",
    "youtube"
  ],
  "author": "hotdog-box",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^24.10.0",
    "obsidian": "^1.14.4",
    "rollup": "^4.66.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
